# Dashboard auth (required)
DASHBOARD_USER=admin
DASHBOARD_PASS=your-password-here

# OpenAI Whisper API (optional — for cloud transcription)
# Without this, Merlin uses local transcription (faster-whisper)
# Get your key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Cloudflare Tunnel (HTTPS access)
# TUNNEL_ENABLED=true          # Set to false to disable tunnel
# TUNNEL_TOKEN=                # Cloudflare Tunnel token for named tunnel (stable URL)
# TUNNEL_HOSTNAME=             # Custom hostname (e.g., merlin.example.com)

# Voice mode text-to-speech (optional). The root of any OpenAI-compatible API:
# Merlin posts to <url>/audio/speech. tools/kokoro-tts-server.py is a reference
# server (Kokoro on a GPU). Without a URL, voice mode is unavailable.
# MERLIN_TTS_URL=http://127.0.0.1:8880/v1
# MERLIN_TTS_API_KEY=          # Sent as "Authorization: Bearer <key>"
# MERLIN_TTS_MODEL=kokoro
# MERLIN_TTS_VOICE_FR=ff_siwis
# MERLIN_TTS_VOICE_EN=af_heart
# MERLIN_TTS_SPEED=1.05
# MERLIN_TTS_FORMAT=wav
