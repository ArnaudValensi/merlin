flowchart TB
    subgraph Triggers["What Triggers Logging"]
        CJ["Job\n(tick or webhook)"]
        WH["Webhook\nrequest"]
        HTTP["HTTP\nrequest"]
        WS["WebSocket\n(terminal)"]
        ATT["Attention\n(a window finished or asks)"]
        TUN["SaaS tunnel\nlifecycle"]
    end

    subgraph Loggers["Unified merlin.* Logger Hierarchy → merlin.log"]
        direction TB
        ML_JOB["merlin.job\n(dispatch, runs, supervision,\nretention)"]
        ML_TERM["merlin.terminal\n(WS connect/disconnect,\nPTY errors)"]
        ML_NOTIF["merlin.notifications\n(watcher, push)"]
        ML_SAAS["merlin.saas_tunnel\n(portal tunnel,\nport forwarding)"]
        ML_SSH["merlin.ssh\n(host key, sessions)"]
        ML_MAIN["merlin\n(extensions, startup)"]
    end

    subgraph Structured["Engine Log Writers"]
        SE_WH["webhooks/\nlog_event(webhook_request)"]
        SE_CRASH["job/__init__.py\nlog_event(job_runner_crash)"]
        SE_ATT["notifications/push.py\nlog_event(attention_routed)"]
        SE_APP["main.py\nlog_event(app_started/stopped)"]
    end

    subgraph PerRun["Per-Run Writers"]
        PR_WIN["runs.launch()\nthe window, @job_* options"]
        PR_DIR["job/runs.py + supervisor.py\nmeta.json, pid, outcome.json"]
        PR_LOG["runner.record_run()\n.history.json, the run log,\nresult.json"]
    end

    subgraph Storage["Disk"]
        F_ML["logs/merlin.log\n🔄 10 MB × 5 backups"]
        F_EL["logs/engine-log.jsonl\n🔄 180-day retention"]
        F_RUNS["job-runs/<run>/\n(removed with the window)"]
        F_JLG["job-logs/{job}/*.json\n🔄 50 per job"]
        F_TMUX["merlin-jobs tmux session\n(the window, until retention)"]
    end

    CJ --> ML_JOB
    HTTP --> ML_MAIN
    WS --> ML_TERM
    ATT --> ML_NOTIF
    TUN --> ML_SAAS

    WH --> SE_WH
    CJ --> SE_CRASH
    ATT --> SE_ATT

    CJ --> PR_WIN
    CJ --> PR_DIR
    CJ --> PR_LOG

    Loggers --> F_ML

    SE_WH & SE_CRASH & SE_ATT & SE_APP --> F_EL
    PR_WIN --> F_TMUX
    PR_DIR --> F_RUNS
    PR_LOG --> F_JLG

