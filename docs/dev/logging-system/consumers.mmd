flowchart LR
    subgraph Storage["Log Files"]
        EL["events.jsonl"]
        JLG["job-logs/{job}/*.json"]
        ACT["logs/activity/*.jsonl"]
        ML["merlin.log"]
        TMUX["merlin-jobs tmux session\n(the run's window)"]
    end

    subgraph Dashboard["Dashboard Pages"]
        JD["Jobs Dashboard\n/jobs\n(history, run logs, crash banner,\nwebhook requests)"]
        TL["Timeline\n/timeline\n(flag on)"]
        TERM["Terminal and Sessions board\n(watch a run, step in)"]
    end

    subgraph Internal["Internal"]
        SUP["job/supervisor.py\n(the finish, the pane capture)"]
        DBG["Manual debugging\n(SSH + read)"]
    end

    EL --> JD
    JLG --> JD
    ACT --> TL
    TMUX --> TERM
    TMUX --> SUP
    ML --> DBG

    style EL fill:#1e3a2f,stroke:#4ade80
    style ACT fill:#1e3a2f,stroke:#4ade80
    style JLG fill:#1e2d4a,stroke:#60a5fa
    style ML fill:#1e3a2f,stroke:#4ade80
    style TMUX fill:#1e2d4a,stroke:#60a5fa
